<plan>
  <spec></spec>
  <design_context></design_context>  <!-- optional, populated when sibling file exists -->
  <created></created>
  <status>draft</status>

  <meta>
    <summary></summary>
    <waves></waves>
    <affected_modules></affected_modules>
    <complexity></complexity>
  </meta>

  <architecture>
    <!--
      Architecture maps the spec's components. Each element reuses the
      exact COMPONENT-UPPER-SLUG identity declared in spec.xml — plan
      components are always a subset of spec components. The child
      <name> element repeats the spec's display name. depends_on holds
      bare component slugs declared in this plan or the spec.
    -->
    <COMPONENT-EXAMPLE>
      <name></name>
      <purpose></purpose>
      <file>
        <path></path>
        <role></role>
      </file>
      <contract>
      </contract>
      <depends_on></depends_on>
    </COMPONENT-EXAMPLE>
  </architecture>

  <tasks>
    <WAVE-1>
      <goal></goal>
      <TASK-T-001>
        <title></title>
        <file></file>
        <status>pending</status>
        <description></description>
        <depends_on>
          <task_id></task_id>
        </depends_on>
        <snippet><![CDATA[
// code here
]]></snippet>
        <acceptance>
          <criterion></criterion>
        </acceptance>
        <verification>
          <command></command>
        </verification>
      </TASK-T-001>
    </WAVE-1>
  </tasks>
</plan>
