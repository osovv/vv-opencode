    <ImplementationPlan>
      <T-001>
        <Title>Upgrade and configure the TUI build surface</Title>
        <DependsOn></DependsOn>
        <AcceptanceCriteria>
          <Criterion>OpenCode plugin/SDK dependencies target 1.18.2, OpenTUI compile-time dependencies and peer contracts are present, TSX compiles, and package exports expose ./tui without breaking existing exports.</Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>bun install</Command>
          <Command>bun run typecheck</Command>
          <Command>bun run build</Command>
        </Verification>
      </T-001>
      <T-002>
        <Title>Implement pure context analysis</Title>
        <DependsOn>T-001</DependsOn>
        <AcceptanceCriteria>
          <Criterion>Pure functions derive measured usage, active post-compaction messages, approximate categories, unknown context, drift, model metadata, and MCP summary from bounded inputs.</Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>bun test src/tui/context/analyze.test.ts</Command>
        </Verification>
      </T-002>
      <T-003>
        <Title>Implement and register the context TUI dialog</Title>
        <DependsOn>
          <Task>T-001</Task>
          <Task>T-002</Task>
        </DependsOn>
        <AcceptanceCriteria>
          <Criterion>The modern keymap command registers slashName context, collects SDK/state data safely, respects the context toggle, and renders an xlarge measured-versus-estimated dialog with warnings and MCP status.</Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>bun test src/tui/context/plugin.test.ts</Command>
          <Command>bun run typecheck</Command>
        </Verification>
      </T-003>
      <T-004>
        <Title>Manage TUI configuration conservatively</Title>
        <DependsOn>T-001</DependsOn>
        <AcceptanceCriteria>
          <Criterion>Path resolution includes dedicated tui.json(c), mutation preserves unrelated JSONC settings and tuple options, install/sync/init register the subpath idempotently, inspection reports failures, and launch pins an existing project-managed TUI config.</Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>bun test src/lib/opencode.test.ts src/lib/config-layers.test.ts src/commands/sync.test.ts src/commands/launch.test.ts src/commands/status.test.ts src/commands/doctor.test.ts</Command>
        </Verification>
      </T-004>
      <T-005>
