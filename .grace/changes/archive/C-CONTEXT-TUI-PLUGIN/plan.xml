        <DependsOn>
          <Task>T-002</Task>
          <Task>T-003</Task>
          <Task>T-004</Task>
        </DependsOn>
        <AcceptanceCriteria>
          <Criterion>The context toggle defaults on, public docs explain /context accuracy and setup, and GRACE requirements/technology/deployment/graph/verification own the new behavior and tests.</Criterion>
