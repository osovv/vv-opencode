{
  "name": "@osovv/vv-opencode",
  "version": "2.1.4",
  "description": "An opinionated agentic development layer for OpenCode — spec-first when it matters, review-driven execution, portable model roles, safer tools, and long-run safety.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugins",
    "workflow",
    "agent-workflow",
    "ai-agent",
    "agent-framework",
    "llm",
    "spec-to-code",
    "bun",
    "cli",
    "typescript",
    "developer-tools",
    "guardian",
    "prompt-engineering",
    "security"
  ],
  "bin": {
    "vvoc": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "templates",
    "server.js",
    "tui.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./plugins/guardian": {
      "types": "./dist/plugins/guardian/index.d.ts",
      "import": "./dist/plugins/guardian/index.js"
    },
    "./plugins/hashline-edit": {
      "types": "./dist/plugins/hashline-edit/index.d.ts",
      "import": "./dist/plugins/hashline-edit/index.js"
    },
    "./plugins/model-roles": {
      "types": "./dist/plugins/model-roles/index.d.ts",
      "import": "./dist/plugins/model-roles/index.js"
    },
    "./plugins/system-context-injection": {
      "types": "./dist/plugins/system-context-injection/index.d.ts",
      "import": "./dist/plugins/system-context-injection/index.js"
    },
    "./plugins/workflow": {
      "types": "./dist/plugins/workflow/index.d.ts",
      "import": "./dist/plugins/workflow/index.js"
    },
    "./plugins/secrets-redaction": {
      "types": "./dist/plugins/secrets-redaction/index.d.ts",
      "import": "./dist/plugins/secrets-redaction/index.js"
    },
    "./plugins/web-tools": {
      "types": "./dist/plugins/web-tools/index.d.ts",
      "import": "./dist/plugins/web-tools/index.js"
    },
    "./plugins/tool-history-compaction": {
      "types": "./dist/plugins/tool-history-compaction/index.d.ts",
      "import": "./dist/plugins/tool-history-compaction/index.js"
    },
    "./plugins/analytics": {
      "types": "./dist/plugins/analytics/index.d.ts",
      "import": "./dist/plugins/analytics/index.js"
    },
    "./plugins/peak-hours": {
      "types": "./dist/plugins/peak-hours/index.d.ts",
      "import": "./dist/plugins/peak-hours/index.js"
    },
    "./plugins/spec-guard": {
      "types": "./dist/plugins/spec-guard/index.d.ts",
      "import": "./dist/plugins/spec-guard/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/plugins/workflow && cp src/plugins/workflow/system-instruction.md dist/plugins/workflow/system-instruction.md",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --deny warnings src",
    "fmt": "oxfmt --write src",
    "fmt:check": "oxfmt --check src",
    "grace:check": "bun scripts/check-grace-markup.ts",
    "contracts:check": "bun scripts/check-tool-contracts.ts",
    "contracts:generate": "bun scripts/check-tool-contracts.ts --generate",
    "contracts:host": "bun scripts/check-tool-contracts-host.ts",
    "e2e:v2": "bun scripts/e2e-v2.ts --full",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run grace:check && bun run contracts:check && bun test",
    "pack:check": "bun run build && bun scripts/check-package.ts && bun scripts/check-tool-contracts.ts --packed",
    "tui:local": "bun scripts/tui-local.ts",
    "release:check": "bun scripts/release-check.ts",
    "release:bump": "bun scripts/release-bump.ts",
    "prepare": "lefthook install --force"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@opencode/ai": "2.0.18",
    "@opencode/client": "2.0.18",
    "@opencode/plugin": "2.0.18",
    "@opencode/protocol": "2.0.18",
    "@opencode/schema": "2.0.18",
    "ajv": "^8.17.1",
    "citty": "0.2.2",
    "effect": "4.0.0-rc.112",
    "htmlparser2": "^12.0.0",
    "jsonc-parser": "3.3.1",
    "turndown": "^7.2.4",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@opentui/core": "0.5.12",
    "@opentui/keymap": "0.5.12",
    "@opentui/solid": "0.5.12",
    "@types/node": "22.13.9",
    "@types/turndown": "^5.0.6",
    "bun-types": "1.3.11",
    "conventional-changelog-cli": "^5.0.0",
    "lefthook": "2.1.5",
    "oxfmt": "0.43.0",
    "oxlint": "1.58.0",
    "solid-js": "1.9.15",
    "typescript": "5.8.2"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.12",
    "@opentui/solid": ">=0.5.12",
    "solid-js": ">=1.9.0"
  },
  "engines": {
    "bun": ">=1.3.8",
    "opencode": ">=2.0.18 <2.0.19"
  },
  "packageManager": "bun@1.3.8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osovv/vv-opencode.git"
  }
}
